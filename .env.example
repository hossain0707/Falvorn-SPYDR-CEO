# Copy to .env, edit values, and load into the process environment (not into Git).
APP_HOST=127.0.0.1
APP_PORT=8787
APP_DB=./data/agentcompany.sqlite3
# Set APP_HTTPS=1 only behind correctly configured HTTPS termination.
APP_HTTPS=0
# Required to make live model calls. Not stored in SQLite or in the browser.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Update these numbers to your provider's actual current rates.
AI_INPUT_PER_MILLION_USD=0.40
AI_OUTPUT_PER_MILLION_USD=1.60
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1600
DEFAULT_MONTHLY_BUDGET_USD=10
